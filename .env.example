# =============================================================================
# EventHub - Variables utilisees par docker-compose
# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_DB=eventhub
POSTGRES_PORT=5432

# --- Ports publies sur la machine hote ---
FRONTEND_PORT=8080
EVENTS_PORT=3001
PARTICIPANTS_PORT=3002
REGISTRATIONS_PORT=3003

# --- Registre d'images (utilise par la CI et docker compose) ---
# En local : eventhub/<service>:latest
# En CI    : ghcr.io/<utilisateur>/<service>:<sha>
REGISTRY=eventhub
TAG=latest
